# ==============================================================================
# HOSTINGER - Laravel Project Root .htaccess
# ==============================================================================
# IMPORTANTE: Configure o Document Root do seu domínio para /public/
# Este arquivo é um fallback caso não possa configurar corretamente
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redireciona todas as requisições para a pasta public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# ==============================================================================
# PHP Handler - Hostinger cPanel (PHP 8.2)
# ==============================================================================
# Defina o pacote "ea-php82" como a linguagem padrão de programação "PHP".
# NOTA: Se você usar uma versão diferente do PHP no Hostinger,
# ajuste "ea-php82" para a versão correta (ex: ea-php81, ea-php83)
<IfModule mime_module>
    AddHandler application/x-httpd-ea-php82___lsphp .php .php8 .phtml
</IfModule>
